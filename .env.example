# Copie para .env e preencha. Este arquivo é lido só pelo servidor (server.js).
# Nunca coloque os tokens em HTML/JS do navegador: qualquer visitante veria.
PORT=3020
APP_URL=https://seu-dominio.com.br

# Meta / Facebook — o ID é público; o token da API de Conversões é SEGREDO.
META_PIXEL_ID=2213639929564048
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# Utmify — o pixelId é público; o token de API é SEGREDO.
UTMIFY_PIXEL_ID=6ace4ed4f94f278cc3eb8329
UTMIFY_API_TOKEN=

# Gateway de pagamento (preencha conforme o gateway escolhido)
GATEWAY_NAME=
GATEWAY_SECRET_KEY=
GATEWAY_WEBHOOK_SECRET=
